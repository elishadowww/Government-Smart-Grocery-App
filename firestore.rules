rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // PriceCatcher reference + price data is public government data.
    // Everyone (including guests, per PRD §4) can read it; only the
    // import script (Admin SDK, bypasses rules) can write it.
    match /products/{itemCode} {
      allow read: if true;
      allow write: if false;
    }

    match /supermarkets/{premiseCode} {
      allow read: if true;
      allow write: if false;
    }

    match /prices/{priceId} {
      allow read: if true;
      allow write: if false;
    }

    match /latest_prices/{priceId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else (users, shopping lists, budgets, etc.) defaults to
    // deny until its own module defines explicit rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
