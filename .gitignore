# =========================
# PriceCatcher data / local SQLite database
# =========================

data/
tools/db_builder/.venv/

# The whole (unsplit) built database exceeds GitHub's 100MB file limit, so
# it's never committed directly — only the pre-split assets/database/*.part*
# files are (each kept under 100MB; see DatabaseService for how they're
# reassembled on-device). If you regenerate pricecatcher.db, re-split it
# before committing rather than dropping the raw file in this folder.
assets/database/*.db

# Leftover from the retired Firestore importer — no longer used, but kept
# ignored defensively in case a credential file reappears here.
keys/
serviceAccountKey.json
*serviceAccountKey*.json
smart-grocery-3b932-firebase-adminsdk-fbsvc-d1d4dd1a7b.json
